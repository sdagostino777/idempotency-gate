<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>IdempotencyGate</PackageId>
    <Description>Idempotency-Key middleware for ASP.NET Core: retries replay the first response instead of charging the customer twice.</Description>
    <PackageTags>idempotency;aspnetcore;middleware;api;retry;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
