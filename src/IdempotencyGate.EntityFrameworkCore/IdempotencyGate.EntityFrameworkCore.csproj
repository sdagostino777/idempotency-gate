<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>IdempotencyGate.EntityFrameworkCore</PackageId>
    <Description>EF Core store for IdempotencyGate: idempotency keys that are shared across every instance of the API.</Description>
    <PackageTags>idempotency;efcore;entityframework;aspnetcore;sqlserver;postgresql</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IdempotencyGate/IdempotencyGate.csproj" />
  </ItemGroup>
</Project>
